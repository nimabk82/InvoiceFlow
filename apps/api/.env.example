NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000

# Email delivery (logger is development/test only; disabled fails sends explicitly)
EMAIL_PROVIDER=logger

# Supabase (required — copy from your Supabase project settings > API)
# Never commit real values here. Copy this file to .env and fill in secrets.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>
SUPABASE_ACCESS_TOKEN=<personal-access-token>
SUPABASE_DB_PASSWORD=<database-password>
