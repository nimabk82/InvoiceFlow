{
  "name": "@invoiceflow/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared InvoiceFlow semantic section renderer",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@invoiceflow/document-schema": "workspace:*",
    "@invoiceflow/theme-schema": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
